    given-names: Maria A.
    email: maserr@bu.edu
    affiliation: "Center for Regenerative Medicine, Boston University Chobanian & Avedisian School of Medicine"
  - family-names: Villacorta Martin
    given-names: Carlos
    affiliation: "Bioinformatics Core, Center for Regenerative Medicine, Boston University"
keywords:
  - data readiness
  - FAIR data
  - knowledge graph
  - provenance
  - flow cytometry
  - single-cell genomics
